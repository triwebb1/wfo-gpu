# EmbedKernel.cmake
# Invoked as: cmake -P EmbedKernel.cmake -DIN=<path> -DOUT=<path> -DSYMBOL=<name>
#
# Reads a kernel source file and emits a C++ header containing a byte-array
# embedding of the file contents (no trailing NUL -- pass length explicitly to
# clCreateProgramWithSource).

cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED IN OR NOT DEFINED OUT OR NOT DEFINED SYMBOL)
    message(FATAL_ERROR "EmbedKernel.cmake requires -DIN=<path> -DOUT=<path> -DSYMBOL=<name>")
endif()

# Read file as hex to safely handle any byte content.
file(READ "${IN}" CONTENT_HEX HEX)

# Strip UTF-8 BOM if present (EF BB BF).
if(CONTENT_HEX MATCHES "^efbbbf")
    string(SUBSTRING "${CONTENT_HEX}" 6 -1 CONTENT_HEX)
endif()

# Compute byte length (2 hex chars per byte).
string(LENGTH "${CONTENT_HEX}" HEX_LEN)
math(EXPR BYTE_LEN "${HEX_LEN} / 2")

# Convert hex string to comma-separated 0xNN byte list.
# NOTE: CMake string operations on large strings are O(n); for a ~23 KB file
# this loop (~750 iterations of 32-byte chunks) is acceptably fast at configure
# time, avoiding any external tool dependency.
set(BYTE_LIST "")
set(OFFSET 0)
set(CHUNK 32)   # Process 32 bytes (64 hex chars) per iteration for speed.
set(REMAINING ${BYTE_LEN})

while(REMAINING GREATER 0)
    if(REMAINING LESS ${CHUNK})
        set(STEP ${REMAINING})
    else()
        set(STEP ${CHUNK})
    endif()
    math(EXPR HEX_OFFSET "${OFFSET} * 2")
    math(EXPR HEX_STEP "${STEP} * 2")
    string(SUBSTRING "${CONTENT_HEX}" ${HEX_OFFSET} ${HEX_STEP} CHUNK_HEX)

    # Split chunk into individual byte pairs.
    set(CHUNK_BYTES "")
    set(I 0)
    while(I LESS ${STEP})
        math(EXPR PAIR_OFF "${I} * 2")
        string(SUBSTRING "${CHUNK_HEX}" ${PAIR_OFF} 2 BYTE_HEX)
        if(CHUNK_BYTES STREQUAL "")
            set(CHUNK_BYTES "0x${BYTE_HEX}")
        else()
            set(CHUNK_BYTES "${CHUNK_BYTES}, 0x${BYTE_HEX}")
        endif()
        math(EXPR I "${I} + 1")
    endwhile()

    if(BYTE_LIST STREQUAL "")
        set(BYTE_LIST "${CHUNK_BYTES}")
    else()
        set(BYTE_LIST "${BYTE_LIST}, ${CHUNK_BYTES}")
    endif()

    math(EXPR OFFSET "${OFFSET} + ${STEP}")
    math(EXPR REMAINING "${REMAINING} - ${STEP}")
endwhile()

# Ensure output directory exists.
get_filename_component(OUT_DIR "${OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${OUT_DIR}")

# Write the header.
set(GUARD "_GENERATED_${SYMBOL}_H_")
string(MAKE_C_IDENTIFIER "${GUARD}" GUARD)
string(TOUPPER "${GUARD}" GUARD)

file(WRITE "${OUT}"
"// Auto-generated by cmake/EmbedKernel.cmake -- DO NOT EDIT.
// Source: ${IN}
#ifndef ${GUARD}
#define ${GUARD}

#include <stddef.h>

namespace wfo {

inline constexpr unsigned char ${SYMBOL}[] = {
    ${BYTE_LIST}
};

inline constexpr size_t ${SYMBOL}_LEN = ${BYTE_LEN};

} // namespace wfo

#endif // ${GUARD}
")

message(STATUS "EmbedKernel: wrote ${BYTE_LEN} bytes -> ${OUT}")
